{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Study Desk",
  "version": "0.2.10",
  "identifier": "link.spookelgoose.studydesk",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../icons/icon.ico",
      "../icons/icon.icns",
      "../icons/icon.png"
    ],
    "resources": {
      "../../dist/backend/StudyDeskBackend/": "backend/"
    },
    "licenseFile": "../../LICENSE",
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "template": "./windows/installer.nsi"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGNkIxQUYyNzU5MURFQzQKUldURTNwRjE4aHByNzlRN0VtcnZKaUNPaGN6RzI3ZVpXMnpDaHA5ZDhvdlpJdmFMMXRuS1JtUEcK",
      "endpoints": [
        "https://raw.githubusercontent.com/LeymansGuz/Study-Desk/main/desktop/update-manifest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
