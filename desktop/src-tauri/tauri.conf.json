{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Study Desk",
  "version": "0.2.2",
  "identifier": "link.spookelgoose.studydesk",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../icons/icon.ico",
      "../icons/icon.icns",
      "../icons/icon.png"
    ],
    "resources": {
      "../../dist/backend/StudyDeskBackend/": "backend/"
    },
    "licenseFile": "../../LICENSE",
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "zlib"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
