# Copy to .env and supply your own key. Never commit .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-flash

# Optional source-edition credentials. The desktop app ignores these variables:
# enter each provider's key in Settings, stored in your OS credential store.
# OPENAI_API_KEY above keeps existing DeepSeek source setups working.
OPENROUTER_API_KEY=
OPENAI_DIRECT_API_KEY=
ANTHROPIC_API_KEY=

# Optional local ports and generation limits.
LOCAL_PORT=8002
LOCAL_OPA_PORT=8182
MAX_CONCURRENT_LLM=5
GENERATION_TIMEOUT_SECONDS=60
GENERATION_COMPLEX_TIMEOUT_SECONDS=90

# Keep local diagnostics and automatic data/log retention enabled.
AUTO_MAINTENANCE=true
MANAGED_LOGGING=true
